{
  "name": "ublockvanced",
  "version": "0.4.0",
  "description": "uBlock Origin fork with Catppuccin Mocha dark theme and Element Probe DevTools panel (dev tooling).",
  "type": "module",
  "scripts": {
    "lint": "eslint --no-warn-ignored --ignore-pattern \"**/lib/\" --ignore-pattern \"**/npm/\" -- \"./src/js/*.js\" \"./src/js/**/*.js\" \"./**/*.json\" \"./platform/**/*.js\"",
    "test": "node --test --test-name-pattern=. tests/classify-classes.test.js tests/element-probe-page-scripts.test.js tests/epicker-model.test.js tests/procedural-suggest.test.js tests/theme-palette.test.js tests/selector-validation.test.js tests/filter-export.test.js tests/filter-list-diff.test.js tests/user-filters.test.js tests/user-filter-stats.test.js",
    "build:ui": "node ui/build.mjs --release",
    "dev:ui": "node ui/build.mjs --watch --sync=dist/build/uBlock0.firefox",
    "typecheck": "tsc -p ui/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SysAdminDoc/uBlockVanced.git"
  },
  "author": "SysAdminDoc (forked from Raymond Hill)",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/SysAdminDoc/uBlockVanced/issues"
  },
  "homepage": "https://github.com/SysAdminDoc/uBlockVanced#readme",
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.4",
    "@eslint/js": "^9.17.0",
    "@eslint/json": "^0.13.1",
    "@material-symbols/svg-400": "^0.47.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "eslint-formatter-compact": "^8.40.0",
    "globals": "^15.14.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@material/web": "^2.5.0",
    "material-expressive-react": "^0.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
